# GEMINI_API_KEY: Clave privada de la API de Gemini (solo servidor, nunca expuesta al cliente).
# En AI Studio se inyecta desde el panel Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública donde se aloja la aplicación (opcional en desarrollo local).
APP_URL="http://localhost:3000"

# PORT: Puerto del servidor Express/Vite (por defecto 3000).
PORT="3000"

# Nota sobre Firebase / Google Drive OAuth:
# La configuración pública del cliente web de Firebase vive en `firebase-applet-config.json`
# (no contiene claves privadas ni secretos de servidor).
