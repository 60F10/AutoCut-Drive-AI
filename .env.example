# ==============================================================================
# AutoCut Drive AI — Variables de entorno de ejemplo
# Copia este archivo a `.env` en local. Nunca subas `.env` con secretos reales.
# ==============================================================================

# GEMINI_API_KEY (OBLIGATORIA en servidor)
# Clave privada de la API de Google Gemini. Solo se lee en `server.ts` y nunca
# se expone al navegador. En AI Studio se inyecta desde Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL / VITE_GEMINI_MODEL (OPCIONALES)
# Modelo de Gemini por defecto (también modificable desde la vista Ajustes).
# Permite migrar de versión sin tocar código si Google actualiza o jubila modelos.
GEMINI_MODEL="gemini-3.8-flash"
VITE_GEMINI_MODEL="gemini-3.8-flash"

# ==============================================================================
# Render en la nube con GitHub Actions (SOLO SERVIDOR — NUNCA prefijo VITE_)
# Ver guía completa en `worker/CLOUD_SETUP.md`
# ==============================================================================

# Fine-grained PAT de GitHub con permiso `Actions: Read and write` en tu repo.
GITHUB_DISPATCH_TOKEN=""

# Repositorio propietario/nombre donde vive `.github/workflows/cloud-render.yml`.
GITHUB_REPO="60F10/AutoCut-Drive-AI"

# Rama que ejecutará el workflow (por defecto `main`).
GITHUB_REF="main"

# ==============================================================================
# Servidor local / despliegue
# ==============================================================================

# APP_URL (OPCIONAL): URL pública donde se aloja la aplicación.
APP_URL="http://localhost:3000"

# PORT (OPCIONAL): Puerto HTTP del servidor Express + Vite (por defecto 3000).
PORT="3000"

# AUTOCUT_DRIVE_DIR (OPCIONAL — solo para el Worker secundario de PC `npm run worker`)
# Ruta local de la carpeta sincronizada de Google Drive para ordenadores.
# AUTOCUT_DRIVE_DIR="G:\Mi unidad\AutoCut_Videos"

# Nota sobre Firebase / Google Drive OAuth:
# La configuración pública del cliente web de Firebase vive en `firebase-applet-config.json`
# (no contiene claves privadas ni secretos de servidor).
