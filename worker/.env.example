# AutoCut Drive AI — Variables locales del PC Worker (Windows)
# Copia este archivo como worker/.env.local (ignorado en git) y completa tus valores.

# Clave privada de Google Gemini para análisis multimodal en el PC (Fases A/B/C)
GEMINI_API_KEY=

# Carpeta local sincronizada de Google Drive configurada en la PWA
AUTOCUT_DRIVE_DIR=G:\Mi unidad\AutoCut_Videos

# Configuración de Whisper en el PC (por defecto: medium + auto con CUDA y fallback CPU)
WHISPER_MODEL=medium
WHISPER_DEVICE=auto

# Opcionales: rutas explícitas si no están en el PATH del sistema
# AUTOCUT_PYTHON_BIN=python
# AUTOCUT_FFMPEG_BIN=ffmpeg
# AUTOCUT_POLL_INTERVAL_MS=3000
